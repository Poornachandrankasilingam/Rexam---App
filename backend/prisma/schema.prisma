generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  role          String          @default("STUDENT")
  phone         String?         @unique
  institute     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  exams         Exam[]          @relation("UserExams")
  results       Result[]
  proctoringLogs ProctoringLog[]
  activityLogs  ActivityLog[]
  subscriptions Subscription[]
  attempts      ExamAttempt[]
  otpVerifications OtpVerification[]
  emailVerified Boolean         @default(false)
  phoneVerified Boolean         @default(false)
  resetCode       String?
  resetCodeExpiry DateTime?
  otpCode         String?
  otpCodeExpiry   DateTime?
  googleId        String?         @unique
  authProvider    String          @default("LOCAL")
  avatar          String?
  aiReports       AiPerformanceReport[]

  @@index([role])
  @@index([createdAt])
}

model Exam {
  id            String     @id @default(uuid())
  title         String
  description   String?
  code          String     @unique
  duration      Int        // in minutes
  startTime     DateTime?
  endTime       DateTime?
  totalMarks    Int
  passingMarks  Int
  sections      Section[]
  questions     Question[]
  createdBy     User       @relation("UserExams", fields: [createdById], references: [id])
  createdById   String
  results       Result[]
  proctoringLogs ProctoringLog[]
  attempts      ExamAttempt[]
  aiReports     AiPerformanceReport[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdById])
  @@index([code])
  @@index([createdAt])
}

model Section {
  id          String     @id @default(uuid())
  name        String
  exam        Exam       @relation(fields: [examId], references: [id])
  examId      String
  questions   Question[]

  @@index([examId])
}

model Question {
  id            String       @id @default(uuid())
  text          String
  type          String       @default("MCQ")
  difficulty    String       @default("MEDIUM")
  marks         Int          @default(1)
  negativeMarks Float        @default(0)
  subject       String
  topic         String?
  explanation   String?
  options       Option[]
  exam          Exam?        @relation(fields: [examId], references: [id])
  examId        String?
  section       Section?     @relation(fields: [sectionId], references: [id])
  sectionId     String?
  pyq           PyqBank?     @relation(fields: [pyqId], references: [id])
  pyqId         String?

  @@index([examId])
  @@index([subject])
  @@index([topic])
  @@index([sectionId])
}

model Option {
  id          String   @id @default(uuid())
  text        String
  isCorrect   Boolean  @default(false)
  question    Question @relation(fields: [questionId], references: [id])
  questionId  String

  @@index([questionId])
}

model Result {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  exam          Exam      @relation(fields: [examId], references: [id])
  examId        String
  score         Float
  totalMarks    Int
  correct       Int
  incorrect     Int
  accuracy      Float
  timeSpent     Int       // in seconds
  analysis      String?   // JSON string
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([examId])
  @@index([userId, createdAt])
}

model ProctoringLog {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  examId        String
  eventType     String   // e.g., "EYE_TRACKING", "FACE_MISSING", "TAB_SWITCH"
  timestamp     DateTime @default(now())
  screenshotUrl String?
  riskScore     Float    @default(0)
  details       String?

  @@index([userId, examId])
  @@index([timestamp])
}

model PyqBank {
  id        String     @id @default(uuid())
  examName  String     // e.g., "SSC CGL"
  year      Int
  subject   String
  topic     String?
  questions Question[]
  createdAt DateTime   @default(now())

  @@index([examName, year])
  @@index([subject])
}

model AIQuestionBank {
  id          String     @id @default(uuid())
  subject     String
  topic       String?
  difficulty  String     @default("MEDIUM")
  question    String
  answer      String
  explanation String?
  createdAt   DateTime   @default(now())

  @@index([subject, topic])
}

model ActivityLog {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model Subscription {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  plan      String   // e.g., "FREE", "PREMIUM"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ExamAttempt {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  exam             Exam     @relation(fields: [examId], references: [id])
  examId           String
  savedAnswersJson String   // JSON string of saved responses
  status           String   @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED
  timeRemainingSec Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([examId])
  @@index([userId, examId])
}

model OtpVerification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String   // email or phone
  type      String   // "EMAIL" or "PHONE"
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  purpose   String   @default("REGISTRATION") // "REGISTRATION", "LOGIN", "FORGOT_PASSWORD"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([target])
  @@index([userId])
}

model AiPerformanceReport {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  exam             Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  examId           String?
  resultId         String?
  overallScore     Float
  totalMarks       Float
  accuracy         Float
  attemptRate      Float
  correctCount     Int
  wrongCount       Int
  unansweredCount  Int
  avgTimePerQ      Float
  readinessScore   Int      // 0-100
  readinessLevel   String   // "Needs Improvement" | "Moderate Preparation" | "Strong Preparation"
  performanceLevel String   // "Needs Improvement" | "Good" | "Excellent"
  strengths        String   // JSON string of array
  weaknesses       String   // JSON string of array
  criticalTopics   String   // JSON string of array
  subjectAnalysis  String   // JSON string of array
  topicAnalysis    String   // JSON string of array
  mistakeAnalysis  String   // JSON string of array
  recommendations  String   // JSON string of array
  studyPlan        String   // JSON string of array
  trendSummary     String?  // Historical comparison text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([resultId])
  @@index([userId, createdAt])
}
